# Copy to .env.local for development. NEVER put real credentials in this file.
# In Dokploy these are set as service environment variables instead.

# SQLite database file (default: ./data/studio.db; container uses /data/studio.db)
DATABASE_PATH=./data/studio.db

# Admin bootstrap: applied only when the users table is empty.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me
